#!/usr/bin/env bash
# Rejoue localement la gate « secrets » de la CI (LL-002) : même version de gitleaks, même
# somme de contrôle, même configuration, sur tout l'historique git puis sur le dossier de
# travail (fichiers non encore commités compris).
#   scripts/secrets
set -euo pipefail
version=8.30.1
sum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
cache="${XDG_CACHE_HOME:-$HOME/.cache}/telemach-kubectl/gitleaks-${version}"
if [ ! -x "$cache/gitleaks" ]; then
	case "$(uname -s)/$(uname -m)" in
	Linux/x86_64) ;;
	*)
		echo "secrets : seul Linux x86_64 est pris en charge (comme la CI) ; installe gitleaks v${version} toi-même" >&2
		exit 2
		;;
	esac
	mkdir -p "$cache"
	archive="$(mktemp "${TMPDIR:-/tmp}/gitleaks.XXXXXX")"
	trap 'rm -f -- "$archive"' EXIT
	curl -sSfL -o "$archive" \
		"https://github.com/gitleaks/gitleaks/releases/download/v${version}/gitleaks_${version}_linux_x64.tar.gz"
	echo "${sum}  ${archive}" | sha256sum -c - >/dev/null
	tar -xzf "$archive" -C "$cache" gitleaks
fi
"$cache/gitleaks" git --config .gitleaks.toml --redact --no-banner .
"$cache/gitleaks" dir --config .gitleaks.toml --redact --no-banner .
